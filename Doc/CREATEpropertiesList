CREATE TABLE PropertiesList (
    id INT AUTO_INCREMENT PRIMARY KEY,
    original_price INT,
    current_price INT,
    number_of_rooms INT,
    number_of_bathrooms INT,
    area_sqft INT,
    address_number INT,
    address_street VARCHAR(50),
    address_city VARCHAR(50),
    address_state VARCHAR(50),
    address_zip INT,
    for_sale BOOLEAN,
    for_rent BOOLEAN,
    garage BOOLEAN,
    garage_spot_number INT,
    pool BOOLEAN,
    hoa BOOLEAN,
    hoa_cost INT,
    description TEXT,
    favorite BOOLEAN DEFAULT FALSE
);

